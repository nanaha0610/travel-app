{
  "name": "travel-app-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.js",
    "start": "node --env-file=.env src/index.js",
    "db:init": "node --env-file=.env src/init-db.js",
    "test": "node --test --test-isolation=none"
  },
  "dependencies": {
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "mysql2": "3.24.5"
  }
}
